{
  "kapybara-buddy": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.kapybara-buddy/hooks/antigravity-hook.sh PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.kapybara-buddy/hooks/antigravity-hook.sh PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.kapybara-buddy/hooks/antigravity-hook.sh PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.kapybara-buddy/hooks/antigravity-hook.sh Stop",
        "timeout": 5
      }
    ]
  }
}
