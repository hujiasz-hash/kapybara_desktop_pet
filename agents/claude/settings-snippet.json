    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.kapybara-buddy/hooks/claude-hook.sh PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.kapybara-buddy/hooks/claude-hook.sh SessionEnd",
            "timeout": 5
